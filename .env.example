# ============================================
# Environment Configuration for Docker Compose
# ============================================

# Application Settings
DEBUG=False
LOG_LEVEL=INFO

# Database Configuration
POSTGRES_USER=libraryuser
POSTGRES_PASSWORD=librarypass
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Service Ports
USER_SERVICE_PORT=8000
BOOK_SERVICE_PORT=8001
LOAN_SERVICE_PORT=8002
FRONTEND_PORT=3000

# JWT Secrets (Change these in production!)
USER_SERVICE_SECRET_KEY=user-service-secret-key-change-in-production-12345
BOOK_SERVICE_SECRET_KEY=book-service-secret-key-change-in-production-12345
LOAN_SERVICE_SECRET_KEY=loan-service-secret-key-change-in-production-12345
INTERNAL_SERVICE_TOKEN=internal-service-token-change-in-production

# Frontend Configuration
REACT_APP_API_BASE_URL=http://localhost:8000
REACT_APP_USER_SERVICE_URL=http://localhost:8000
REACT_APP_BOOK_SERVICE_URL=http://localhost:8001
REACT_APP_LOAN_SERVICE_URL=http://localhost:8002
